# HubSpot form destination (public identifiers, not API tokens).
# Add the contact properties/form fields listed in README.md before enabling.
NEXT_PUBLIC_HUBSPOT_PORTAL_ID=
NEXT_PUBLIC_HUBSPOT_FORM_ID=

# Optional alternative JSON endpoint, used only when HubSpot IDs are both blank.
NEXT_PUBLIC_MEETING_FORM_ENDPOINT=

# Optional: event-specific private booking links shown on the leadership cards.
# Defaults to each team member's HubSpot SBC Lisbon 2026 meeting link when left blank.
NEXT_PUBLIC_IRAKLI_BOOKING_URL=
NEXT_PUBLIC_VAKHTANG_BOOKING_URL=
NEXT_PUBLIC_NEGIN_BOOKING_URL=

# Meeting attribution defaults. Incoming source/medium/campaign UTMs take precedence.
# utm_content identifies the CTA (hero, team_irakli, integration, final, etc.).
NEXT_PUBLIC_BOOKING_UTM_SOURCE=promofy_website
NEXT_PUBLIC_BOOKING_UTM_MEDIUM=website
NEXT_PUBLIC_BOOKING_UTM_CAMPAIGN=sbc_lisbon_2026
